# All Togetharr environment configuration
# Copy to .env.local (local dev) or .env (docker) and fill in values.

# Where the SQLite database lives.
# - Local dev (prisma CLI / next dev): relative to prisma/ directory
# - Docker: absolute path inside the container volume
DATABASE_URL="file:./sqlite.db"

# Optional: interval (ms) between background health checks of connected services
HEALTH_CHECK_INTERVAL_MS="30000"
